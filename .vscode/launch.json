{
  "version": "0.2.0",
  "configurations": [
    {
      "name": ".NET: ClaimsDesk.Api",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "api: build",
      "program": "${workspaceFolder}/src/ClaimsDesk.Api/bin/Debug/net10.0/ClaimsDesk.Api.dll",
      "cwd": "${workspaceFolder}/src/ClaimsDesk.Api",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5080"
      },
      "console": "internalConsole",
      "stopAtEntry": false
    }
  ]
}
